{
  "name": "styling",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node Database/app.js",
    "server": "node --env-file-if-exists=Database/.env Database/app.js",
    "build": "vite build",
    "check:lessons": "node scripts/check-lessons.mjs",
    "check:render": "vite build --ssr scripts/ssr-check.jsx --outDir .ssr-check --emptyOutDir && node .ssr-check/ssr-check.js",
    "check": "npm run check:lessons && npm run check:render && npm run build",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@vitejs/plugin-react": "^4.0.1",
    "eslint": "^8.44.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "vite": "^8.3.2"
  }
}
